              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startDate\": \"2026-04-25\",\n  \"endDate\": \"2026-04-25\",\n  \"startTime\": \"09:00\",\n  \"endTime\": \"11:00\",\n  \"reason\": \"Team Meeting\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/facilities/1/book",
              "host": ["{{baseUrl}}"],
              "path": ["facilities", "1", "book"]
            }
          }
        }
      ]
    },
    {
      "name": "Events",
      "item": [
