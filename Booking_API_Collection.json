{
	"info": {
		"_postman_id": "06e68d83-4a18-4796-9f7a-8ae868351052",
		"name": "Smart Campus Booking API",
		"description": "API collection for the Smart Campus Operations Hub Booking Module (IT3030)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Create Booking - Success",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" },
					{ "key": "Content-Type", "value": "application/json", "type": "text" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"resourceId\": 1,\n    \"bookingDate\": \"2026-05-01\",\n    \"startTime\": \"10:00:00\",\n    \"endTime\": \"12:00:00\",\n    \"purpose\": \"Team Brainstorming\",\n    \"expectedAttendees\": 5\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/v1/bookings",
					"host": ["{{base_url}}"],
					"path": ["api", "v1", "bookings"]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": ["pm.test('Status is 201 Created', () => pm.response.to.have.status(201));"]
					}
				}
			]
		},
		{
			"name": "Create Booking - Conflict (409)",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" },
					{ "key": "Content-Type", "value": "application/json", "type": "text" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"resourceId\": 1,\n    \"bookingDate\": \"2026-05-01\",\n    \"startTime\": \"11:00:00\",\n    \"endTime\": \"13:00:00\",\n    \"purpose\": \"Conflicting Meeting\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/v1/bookings",
					"host": ["{{base_url}}"],
					"path": ["api", "v1", "bookings"]
