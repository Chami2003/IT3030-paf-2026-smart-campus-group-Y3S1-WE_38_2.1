				],
				"url": {
					"raw": "{{base_url}}/api/v1/bookings?status=PENDING",
					"host": ["{{base_url}}"],
					"path": ["api", "v1", "bookings"],
					"query": [{ "key": "status", "value": "PENDING" }]
