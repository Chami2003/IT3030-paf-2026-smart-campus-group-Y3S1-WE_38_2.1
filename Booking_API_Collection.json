			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": ["pm.test('Status is 200 OK or 404', () => pm.expect(pm.response.code).to.be.oneOf([200, 404]));"]
					}
				}
			]
		},
		{
			"name": "Admin - Get All Bookings (Filtered)",
